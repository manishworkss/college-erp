// Prisma Schema for MKR College ERP
// Matashri Kaushalya Ramdev Dr. Ganesh Ray Degree College (Sitamarhi, Bihar)
// Affiliated with B.R.A. Bihar University (BRABU), Muzaffarpur

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  ACCOUNTANT
  TEACHER
  CLERK
  STUDENT
}

enum StudentStatus {
  APPLIED
  VERIFIED
  ADMITTED
  REJECTED
  ALUMNI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  ONLINE_GATEWAY
  BANK_CHALLAN
}

enum SubjectCategory {
  MJC // Major Core Course
  MIC // Minor Course
  MDC // Multidisciplinary Course
  AEC // Ability Enhancement Course
  SEC // Skill Enhancement Course
  VAC // Value Added Course
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(STUDENT)
  isActive     Boolean     @default(true)
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  student      Student?
  auditLogs    AuditLog[]

  @@map("users")
}

model AcademicSession {
  id        String    @id @default(cuid())
  name      String    @unique // e.g. "2026-2030", "2025-2029"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  students  Student[]

  @@map("academic_sessions")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "History", "Political Science", "Commerce"
  code        String   @unique // e.g. "HIST", "POLS", "COMM"
  facultyType String   // "Social Science", "Humanities", "Commerce"
  createdAt   DateTime @default(now())

  courses     Course[]
  subjects    Subject[]

  @@map("departments")
}

model Course {
  id           String      @id @default(cuid())
  name         String      // e.g. "Bachelor of Arts (Honours)", "Bachelor of Commerce"
  code         String      @unique // e.g. "BA", "BCOM"
  durationYear Int         @default(4) // 4-year CBCS
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  students     Student[]
  subjects     Subject[]

  @@map("courses")
}

model Subject {
  id           String          @id @default(cuid())
  code         String          @unique // e.g. "HIST-MJC-1"
  name         String          // e.g. "Idea of Bharat"
  semester     Int             // 1 to 8
  credits      Int             @default(4)
  category     SubjectCategory
  courseId     String
  course       Course          @relation(fields: [courseId], references: [id])
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  createdAt    DateTime        @default(now())

  enrollments  StudentSubjectEnrollment[]

  @@map("subjects")
}

model Student {
  id             String          @id @default(cuid())
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Registration & IDs
  applicationNo  String          @unique // e.g. "MKR-2026-0001"
  collegeRollNo  String?         @unique
  universityRegNo String?        @unique // BRABU Registration Number
  
  // Personal Details
  fullName       String
  fatherName     String
  motherName     String
  dateOfBirth    DateTime
  gender         String          // "Male", "Female", "Other"
  category       String          // "GEN", "OBC", "EBC", "SC", "ST", "EWS"
  aadharNo       String?
  phone          String
  email          String
  address        String          @db.Text
  photoUrl       String?
  signatureUrl   String?
  
  // Academic Association
  sessionId      String
  session        AcademicSession @relation(fields: [sessionId], references: [id])
  courseId       String
  course         Course          @relation(fields: [courseId], references: [id])
  currentSemester Int            @default(1)
  status         StudentStatus   @default(APPLIED)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subjectSelections StudentSubjectEnrollment[]
  feePayments       FeePayment[]

  @@index([sessionId])
  @@index([courseId])
  @@map("students")
}

model StudentSubjectEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  semester   Int
  createdAt  DateTime @default(now())

  @@unique([studentId, subjectId, semester])
  @@map("student_subject_enrollments")
}

model FeePayment {
  id            String        @id @default(cuid())
  receiptNo     String        @unique // e.g. "REC-2026-000123"
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  title         String        // e.g. "UG Semester 1 Admission & Examination Fee"
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(ONLINE_GATEWAY)
  status        PaymentStatus @default(PENDING)
  transactionRef String?      @unique // Bank/Gateway UTR or Transaction ID
  paidAt        DateTime?
  challanUrl    String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([studentId])
  @@index([status])
  @@map("fee_payments")
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  category    String   @default("General") // "Academic", "Admission", "Exam", "General"
  isPublished Boolean  @default(true)
  attachment  String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notices")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "STUDENT_VERIFIED", "FEE_COLLECTED"
  entity    String   // e.g. "Student", "FeePayment"
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}

